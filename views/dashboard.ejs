<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/IMG/AboAnasSweets.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>Dashboard</title>
</head>
<body>
<div class="orders-container">

<% items.forEach(item => { %>

<div class="order-card">

    <h2><%= item.yourName %></h2>

    <div class="info">
        <p><strong>📞 الهاتف:</strong> <%= item.yourPhone %></p>
        <p><strong>🕒 الوقت:</strong> <%= item.time ? from24to12(item.time) : "غير محدد" %></p>
        <p><strong>📅 التاريخ:</strong>
            <br>
            <%= item.dayOfMonth %>-->اليوم
            <br>
            <%= item.month %>-->الشهر
        </p>
        <p><strong>⚖️ الكمية:</strong> <%= Number(item.quantity) %> كيلو</p>
    </div>
    <div class="notes">
        <strong>📝 ملاحظات:</strong>
        <p><%= (item.additionalNotes !== "" && item.additionalNotes !== "يمكنك تركه فارغاً في حال عدم وجود ملاحظات.") ? item.additionalNotes : "لا توجد ملاحظات" %></p>
    </div>
<div class="together">
    <form action="/delete/<%= item._id %>" method="POST">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i></button>
    </form>
    <form action="/debt/<%= item._id %>" method="POST">
        <button type="submit" class="btn btn-warning"><i class="bi bi-wallet2"></i></button>
    </form>    
</div>
<% }) %>
</div>

<% if (debts && debts.length > 0) { %>
<br>
<h1 style="text-align:center; color:#b8860b; font-weight:800; background:white; max-width:500px; margin:20px auto; padding:15px; border-radius:20px; border:3px solid #f0c040;">الديون</h1>
<div class="orders-container">
<% debts.forEach(debt => { %>
<div class="order-card">
    <div class="info">
        <p><strong>📞 الهاتف:</strong> <%= debt.yourPhone %></p>
        <p><strong>⚖️ الكمية:</strong> <%= Number(debt.quantity) %> كيلو</p>
        <p><strong>💰 المبلغ:</strong> <%= Math.ceil(Number(debt.quantity) * 25) %> شيكل</p>
        <hr>
        <form action="/delete/<%= debt._id %>" method="POST">
             <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i></button>
        </form>
    </div>
</div>
<% }) %>
</div>
<% } %>
</div>
<div id="links">
    <a href="/" class="submit-btn">الرجوع للرئيسية</a>
</div>


<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

a{
    text-decoration:none;
}

body{
    font-family:'Cairo',sans-serif;
    direction:rtl;
    background:#fdf7e8;
    min-height:100vh;
    padding:40px 20px;
}

.orders-container{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(350px,1fr));
    gap:25px;
}

.order-card{
    background:white;
    border:2px solid #e6c76b;
    border-radius:18px;
    padding:22px;
    box-shadow:0 6px 18px rgba(0,0,0,.08);
    transition:.2s;
}

.order-card:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 24px rgba(0,0,0,.12);
}

.order-card h2{
    color:#b8860b;
    font-size:1.4rem;
    font-weight:800;
    margin-bottom:18px;
    padding-bottom:10px;
    border-bottom:2px solid #f3e2aa;
}

.info p{
    margin:8px 0;
    padding:10px 12px;
    background:#fff9ef;
    border-radius:10px;
    line-height:1.7;
}

strong{
    color:#b8860b;
}

.notes{
    margin-top:15px;
    padding:12px;
    background:#fff8dc;
    border-left:4px solid #d4a017;
    border-radius:10px;
}

.notes p{
    margin-top:8px;
    color:#555;
    line-height:1.6;
}

.together{
    display:flex;
    gap:10px;
    margin-top:18px;
}

.together form{
    flex:1;
}

.together button{
    width:100%;
}

#links{
    max-width:400px;
    margin:35px auto 0;
}

.submit-btn{
    display:block;
    width:100%;
    text-align:center;
    padding:14px;
    border-radius:10px;
    background:#d4a017;
    color:white;
    font-size:1.1rem;
    font-weight:bold;
    transition:.2s;
}

.submit-btn:hover{
    background:#b8860b;
}

h1{
    text-align:center;
    color:#b8860b;
    background:white;
    max-width:500px;
    margin:25px auto;
    padding:15px;
    border-radius:15px;
    border:2px solid #e6c76b;
    box-shadow:0 4px 12px rgba(0,0,0,.08);
}

.btn-danger,
.btn-warning{
    border-radius:8px;
}
</style>
    
    <script src="/javascript/time.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>